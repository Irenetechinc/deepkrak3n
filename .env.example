# Railway provides PORT automatically. Do not commit secrets here.
PORT=8000

# Comma-separated browser origins allowed to call this standalone service.
# Use the deployed DeepKrak3n frontend URL in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Search reliability controls.
MAX_CONCURRENCY=8
PROXY_MAX_RETRIES=2
PROXY_BACKOFF_BASE=0.5

# Optional public proxy configuration. Leave disabled unless explicitly needed.
PROXY_ENABLED=false
PROXY_LIST=
PROXY_ROTATION_MODE=round_robin
PROXY_ALLOW_DIRECT_FALLBACK=true
PROXY_AUTO_FETCH=false

# Optional local Ollama analysis settings.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_API_MODE=ollama
OLLAMA_TIMEOUT=60